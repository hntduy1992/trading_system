# =============================================================================
# ENVIRONMENT CONFIGURATION: PAPER TRADING / SIMULATION (.env.paper.example)
# Use this configuration for backtesting, dry-runs, and offline development.
# =============================================================================

# --- AI CONFIGURATION ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# --- TRADING MODE & SYMBOL ---
TRADING_MODE=paper
SYMBOL=XAUUSD

# --- NETWORK PORTS ---
SERVER_A_HOST=127.0.0.1
SERVER_A_PORT=29120
SERVER_B_HOST=127.0.0.1
SERVER_B_PORT=29121

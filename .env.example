# =============================================================================
# YTC PRICE ACTION TRADER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env, .env.paper, or .env.live and customize as needed.
# DO NOT COMMIT REAL API KEYS OR BROKER PASSWORDS TO GIT!
# =============================================================================

# --- 1. AI STRATEGY ENGINE & API KEYS ---
# Provider: 'gemini' (Google Generative AI), 'openai', or 'mock' (Offline fallback)
AI_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
# Example: AIzaSyD...
GEMINI_API_KEY=

# OpenAI API Key (Optional, if using provider=openai)
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# Model Name:
# For Gemini: gemini-2.0-flash (Recommended), gemini-2.5-pro, gemini-2.5-flash
# For OpenAI: gpt-4o, gpt-4o-mini
AI_MODEL_NAME=gemini-2.0-flash


# --- 2. BROKER & EXECUTION SETTINGS ---
# TRADING_MODE: 'paper' (Simulation without MT5) or 'live' (Real MT5 Terminal)
TRADING_MODE=paper

# Default Symbol: XAUUSD, EURUSD, BTCUSD, etc.
SYMBOL=XAUUSD

# MetaTrader 5 Terminal Configuration (Required only if TRADING_MODE=live)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=


# --- 3. DEDICATED NETWORK PORTS ---
# Custom high-range ports avoiding conflicts with dev ports (3000, 5000, 8000, 8080)
SERVER_A_HOST=127.0.0.1
SERVER_A_PORT=29120

SERVER_B_HOST=127.0.0.1
SERVER_B_PORT=29121

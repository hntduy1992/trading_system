# =============================================================================
# ENVIRONMENT CONFIGURATION: LIVE TRADING / METATRADER 5 (.env.live.example)
# Use this configuration for real MT5 execution. Keep this file private!
# =============================================================================

# --- AI CONFIGURATION ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# --- TRADING MODE & SYMBOL ---
TRADING_MODE=live
SYMBOL=XAUUSD

# --- METATRADER 5 ACCOUNT CREDENTIALS ---
# Leave login/password empty if MT5 is already opened and logged in on this PC
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- NETWORK PORTS ---
SERVER_A_HOST=127.0.0.1
SERVER_A_PORT=29120
SERVER_B_HOST=127.0.0.1
SERVER_B_PORT=29121
